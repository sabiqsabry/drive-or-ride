# Optional: enables Google Places search, traffic-aware routing and Google route maps.
# Without it the app uses free OpenStreetMap services.
# Enable: Maps JavaScript API, Places API (New), Routes API. Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Cloud Console (Map Management). Defaults to DEMO_MAP_ID for development.
VITE_GOOGLE_MAP_ID=
