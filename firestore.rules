rules_version = '2';
// Anonymous fare quotes from "Got a quote?". Public clients may only create well-formed
// documents; nobody can read, update or delete them through the client API.
// Data is read from the Cloud Console (or with server credentials) to calibrate tariffs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /quotes/{id} {
      allow create: if isQuote(request.resource.data);
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function num(v, lo, hi) { return (v is int || v is float) && v >= lo && v <= hi; }
  function str(v, max) { return v is string && v.size() <= max; }

  function isQuote(d) {
    return d.keys().hasAll(['v', 'country', 'service', 'category', 'kind', 'quote', 'estimate', 'estimateLow',
             'estimateHigh', 'distanceKm', 'durationMin', 'hour', 'weekday', 'rain', 'fromLat', 'fromLon',
             'toLat', 'toLon', 'provider'])
      && d.keys().hasOnly(['v', 'country', 'service', 'category', 'kind', 'quote', 'estimate', 'estimateLow',
             'estimateHigh', 'distanceKm', 'durationMin', 'trafficRatio', 'hour', 'weekday', 'rain', 'fromLat',
             'fromLon', 'toLat', 'toLon', 'provider'])
      && d.v is int
      && str(d.country, 3) && str(d['service'], 24) && str(d.category, 24)
      && d.kind in ['tuk', 'bike', 'car', 'xl']
      && num(d.quote, 1, 10000000) && num(d.estimate, 0, 10000000)
      && num(d.estimateLow, 0, 10000000) && num(d.estimateHigh, 0, 10000000)
      && num(d.distanceKm, 0, 3000) && num(d.durationMin, 0, 6000)
      && (!('trafficRatio' in d) || num(d.trafficRatio, 0, 10))
      && d.hour is int && d.hour >= 0 && d.hour <= 23
      && d.weekday is int && d.weekday >= 0 && d.weekday <= 6
      && d.rain is bool
      && num(d.fromLat, -90, 90) && num(d.fromLon, -180, 180)
      && num(d.toLat, -90, 90) && num(d.toLon, -180, 180)
      && d.provider in ['google', 'osm'];
  }
}
